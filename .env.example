# Transport: "websocket" (default, talks to the FastAPI engine) or "mock"
# (in-browser event simulator used only while the backend is still being built).
NEXT_PUBLIC_TRANSPORT=websocket

# Absolute WS endpoint. Leave unset to derive it from window.location,
# which is what the single-container deployment relies on.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/stream
